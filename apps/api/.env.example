# ---------- Server ----------

# development | staging | production | test. Staging and production hide stack traces
# and log JSON.
NODE_ENV=development

# The port the API listens on.
PORT=3000

# How many reverse proxies sit in front of the API, so the rate limits key on the caller's
# IP. 0 locally, 1 behind one proxy.
TRUST_PROXY=0

# Comma separated. The CORS allowlist and the domain a wallet may sign in for. 5173 is
# the Vite default the web app runs on.
PANEL_ORIGINS=http://localhost:5173

# error | warn | info | debug
LOG_LEVEL=debug

# ---------- Database ----------

# The API's own Postgres. docker compose up starts this one locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# The indexer's Postgres, where token trades are read from. Locally, the one apps/indexer
# runs on 5435. Deployed, connect as a read only user: sql/indexer-read-only-user.sql
# creates one. pnpm test:e2e drops and reseeds the indexer schema here.
INDEXER_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/indexer

# ---------- Redis ----------

# Rate limits, sign in nonces, the market cache and the job queues.
REDIS_URL=redis://localhost:6379

# ---------- Chain ----------

# The chain the launchpad is deployed on, by its EIP-155 chain id. The example is
# Robinhood Chain testnet.
CHAIN_ID=46630

# An RPC endpoint for that chain. The creator check and the sign in check read it.
RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc

# The launch factory every token is launched from, and where its creator is read.
FACTORY_ADDRESS=0xFb51A8b33eF1B280ECAC995C7b2a4237EFC21DeC

# Uniswap v4's PoolManager on this chain. The holders list labels its balance.
POOL_MANAGER_ADDRESS=0x8366a39CC670B4001A1121B8F6A443A643e40951

# The launchpad's hook, locker and buyback vault. The holders list labels their balances.
HOOK_ADDRESS=0x6Bb597c89cD74147412833dDE425D600AD63e044
LOCKER_ADDRESS=0xe11110818B36Cd568dC8A74990D6630764B09bcF
BUYBACK_VAULT_ADDRESS=0x1642c6c8Bdcb418e8CA1645ec625527ECdaDe8DA

# ---------- Auth ----------

# Signs the session credential. At least 32 characters. Rotating it signs every creator out.
JWT_SECRET=change-me-to-at-least-32-characters-long

# The admin key, sent in the X-Admin-Key header. At least 32 characters.
ADMIN_API_KEY=change-me-to-at-least-32-characters-long

# ---------- Logos ----------

# The token of one UploadThing app, from its dashboard, where token logos are stored.
# Required: the API refuses to boot without one. Use a different app per environment.
UPLOADTHING_TOKEN=

# ---------- USD rates ----------

# Serves each quote asset's dollar rate from Chainlink. Off, or on with no feed set,
# every USD field is null.
DOLLAR_RATES=false

# The chain the feeds live on. Empty falls back to RPC_URL and CHAIN_ID. A testnet can
# point at its mainnet, so its quote assets are priced by the real assets.
DOLLAR_RATE_RPC_URL=
DOLLAR_RATE_CHAIN_ID=

# The Chainlink aggregator pricing the chain's native token in USD, such as ETH / USD.
NATIVE_USD_FEED=

# Comma separated 0xQuoteAsset:0xFeed pairs, one Chainlink USD feed per ERC-20 quote asset.
QUOTE_ASSET_USD_FEEDS=

# ---------- Agents ----------

# The AI agent that posts to X for a token: its X connection, previews and posting worker.
# Off by default. Off, nothing below is required and the agent routes answer 404.
AGENTS_ENABLED=false

# Encrypts every X credential at rest. A base64 key of exactly 32 bytes, from
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# The app registered in the X developer console, which every creator's account connects to.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Where X returns the creator. Must match a callback URL registered at X exactly.
X_CALLBACK_URL=http://localhost:3000/api/v1/core/connections/callback

# true runs every step but the one call that publishes to X.
X_DRY_RUN=false

# The key the writer bills against. Mastra reads it from the environment itself.
OPENAI_API_KEY=

# The model every agent writes with. Empty uses openai/gpt-5.6-luna.
AI_MODEL=
