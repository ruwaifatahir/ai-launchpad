# Copy to .env.local and fill in. The values below are a public deployment on Robinhood Chain
# testnet, so the app runs locally as is. Replace them with the output of `pnpm print-env`.
# Every variable is read at build time and checked when the app
# starts: a missing or malformed one shows a configuration error screen naming it.

# --- API ---------------------------------------------------------------------------------------

# Base URL of the AI Launchpad API. The API only answers origins it allowlists.
VITE_API_URL=http://localhost:3000

# Optional. Free project ID from https://dashboard.reown.com; enables QR and mobile wallets. Browser wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Chain -------------------------------------------------------------------------------------

# Numeric chain ID the app runs on; wallets are asked to switch to it.
VITE_CHAIN_ID=46630
# Chain name shown in the UI and offered to wallets that do not know the chain yet.
VITE_CHAIN_NAME=Robinhood Chain Testnet
# JSON-RPC URL. Several, comma-separated, are tried in order.
VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Native currency name (18 decimals assumed).
VITE_NATIVE_CURRENCY_NAME=Ether
# Native currency symbol, used for fees and native-paired launches.
VITE_NATIVE_CURRENCY_SYMBOL=ETH
# Optional. Native currency icon, a path under public/ or a URL. Defaults to /ethereum.svg.
VITE_NATIVE_CURRENCY_LOGO=
# Block explorer base URL; token, transaction and address links are built as /token/…, /tx/…, /address/….
VITE_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# "true" on a testnet, "false" otherwise (default false).
VITE_TESTNET=true
# Optional. Faucet URL; when set, the launch form links to it for test funds. Leave empty to hide the link.
VITE_FAUCET_URL=https://faucet.testnet.chain.robinhood.com
# Optional. Multicall3 address; defaults to the canonical 0xcA11bde05977b3631167028862bE2a173976CA11.
VITE_MULTICALL3_ADDRESS=

# --- Launchpad contracts (the deploy script writes these) --------------------------------------

# LaunchFactory: creates launches and reports their records and terms.
VITE_LAUNCH_FACTORY_ADDRESS=0xFb51A8b33eF1B280ECAC995C7b2a4237EFC21DeC
# LaunchAndBuy: launches and makes the Developer buy in one transaction.
VITE_LAUNCH_AND_BUY_ADDRESS=0x174587Ce2B56b39D7C580dED9cbe5aA7227060B7
# The Uniswap v4 hook on every graduated Pool (the factory's memeHook()).
VITE_MEME_HOOK_ADDRESS=0x6Bb597c89cD74147412833dDE425D600AD63e044
# FeeEscrow: holds creator fees until the Creator wallet claims them.
VITE_FEE_ESCROW_ADDRESS=0x8c694acA8096fc6D8f3aC069496D092b45Ebfc0d

# --- Uniswap v4 periphery on this chain (must serve the factory's PoolManager) ------------------

# V4Quoter: quotes Pool swaps.
VITE_V4_QUOTER_ADDRESS=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
# StateView: reads a Pool's price.
VITE_STATE_VIEW_ADDRESS=0x3b30053dE2d1B31653732D5D8f713Cb1A8771D84
# UniversalRouter: executes Pool swaps.
VITE_UNIVERSAL_ROUTER_ADDRESS=0x8876789976dEcBfCbBbe364623C63652db8C0904
# Optional. Permit2; defaults to the canonical address, the same on every chain.
VITE_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- Quote assets ------------------------------------------------------------------------------

# Optional. ERC-20s a launch can pair with besides the native asset, as a JSON array. Each entry needs
# address, symbol, name and decimals; "logo" (path or URL, default /pairs/<symbol>.svg) and
# "mintable" (true for a test token with a public mint) are optional. Empty means native only.
# Example: [{"address":"0x0000000000000000000000000000000000000008","symbol":"USDC","name":"USD Coin","decimals":6,"logo":"/pairs/usdc.svg"}]
VITE_QUOTE_ASSETS=

# --- Features ----------------------------------------------------------------------------------

# "true" shows AI Agents that post to X for a token; the API must have them enabled too (default false).
VITE_AGENTS_ENABLED=false
