# The chain the launchpad is deployed on, by its EIP-155 chain id.
CHAIN_ID=46630

# An RPC endpoint for that chain. It must serve eth_getLogs over wide block ranges to
# backfill; some free tiers cap the range at ten blocks and cannot.
RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc

# The block the launchpad was deployed in. Every contract is indexed from here.
START_BLOCK=123983012

# The launch factory: every launch, its token and its curve are found from its events.
FACTORY_ADDRESS=0xFb51A8b33eF1B280ECAC995C7b2a4237EFC21DeC

# The Uniswap v4 hook on every graduated launch's pool: pool trades are found from it.
HOOK_ADDRESS=0x6Bb597c89cD74147412833dDE425D600AD63e044

# The buyback vault. Its balance of a launch token is tagged, not counted as a holder.
BUYBACK_VAULT_ADDRESS=0x1642c6c8Bdcb418e8CA1645ec625527ECdaDe8DA

# The launch locker. Its balance of a launch token is tagged, not counted as a holder.
LOCKER_ADDRESS=0xe11110818B36Cd568dC8A74990D6630764B09bcF

# Uniswap v4's PoolManager on this chain. Pool swaps are read from its logs.
POOL_MANAGER_ADDRESS=0x8366a39CC670B4001A1121B8F6A443A643e40951

# The indexer's own Postgres. docker compose up starts this one locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/indexer

# The Postgres schema Ponder writes to. The API reads the schema "indexer", so pnpm dev
# writes there directly. pnpm start and the Docker image write elsewhere and point views
# named "indexer" at their tables, so for them set another name. The image sets its own.
DATABASE_SCHEMA=indexer

# Smoke run only: stop every contract at this block. Leave unset otherwise.
# SMOKE_END_BLOCK=124160000
