{
  "name": "@ai-launchpad/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pons V2 launchpad contracts, unchanged from the verified source, with deploy scripts for any chain with Uniswap v4",
  "scripts": {
    "build": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "size": "hardhat run scripts/size.ts",
    "mine": "hardhat run scripts/mineHookSalt.ts",
    "deploy:target": "hardhat run scripts/deploy.ts --network target",
    "deploy:launch-and-buy": "hardhat run scripts/deployLaunchAndBuy.ts --network target",
    "quote:add": "hardhat run scripts/addQuoteAsset.ts --network target",
    "print-env": "hardhat run scripts/printEnv.ts",
    "rehearse": "hardhat run scripts/forkRehearsal.ts --network ponsFork",
    "parity": "hardhat run scripts/verifyParity.ts",
    "scenario:1": "hardhat run scripts/scenarios/01-lifecycle.ts --network ponsFork",
    "scenario:2": "hardhat run scripts/scenarios/02-postGraduation.ts --network ponsFork",
    "scenario:3": "hardhat run scripts/scenarios/03-erc20Quote.ts --network ponsFork",
    "scenario:4": "hardhat run scripts/scenarios/04-adminSurface.ts --network ponsFork",
    "scenario:5": "hardhat run scripts/scenarios/05-failurePaths.ts --network ponsFork",
    "scenario:all": "pnpm scenario:1 && pnpm scenario:2 && pnpm scenario:3 && pnpm scenario:4 && pnpm scenario:5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/node": "^26.6.2",
    "dotenv": "^17.0.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.0.0",
    "typescript": "^7.0.2"
  }
}
