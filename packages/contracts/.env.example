# ── Deploying to a new chain (network `target`) ──────────────────────────────
# JSON-RPC endpoint of the chain to deploy to.
TARGET_RPC_URL=
# Chain id of that chain; Hardhat refuses to send if the RPC reports another.
TARGET_CHAIN_ID=
# Private key of the deploying account (0x-prefixed). Never commit a real one.
DEPLOYER_PRIVATE_KEY=

# Uniswap V4 PoolManager on the target chain. Required unless the chain is 4663 or 46630.
POOL_MANAGER=
# Uniswap V4 PositionManager wired to that PoolManager. Required unless the chain is 4663 or 46630.
POSITION_MANAGER=
# Permit2 (usually 0x000000000022D473030F116dDEE9F6B43aC78BA3). Required unless the chain is 4663 or 46630.
PERMIT2=

# Final owner of the protocol contracts, e.g. a multisig; empty keeps the deployer. It must call acceptOwnership() on each.
OWNER=
# Receiver of the protocol's fee share; empty means OWNER, or the deployer if OWNER is empty.
PROTOCOL_FEE_RECIPIENT=
# Fee in wei of the native asset charged per launch.
LAUNCH_FEE=500000000000000
# Virtual native reserve the curve starts with, in wei; empty uses 1.68e18, sized for ETH as the native asset.
LAUNCH_PHANTOM_QUOTE=
# Real native raised at which a launch graduates to Uniswap V4, in wei; empty uses 4.2e18, sized for ETH.
LAUNCH_GRADUATION_THRESHOLD=
# "false" deploys without adding launch config #0 and enabling launches.
CONFIGURE=
# "false" skips PonsV2LaunchAndBuy (atomic launch + developer buy); add it later with deploy:launch-and-buy.
LAUNCH_AND_BUY=

# Deployment file for deploy:launch-and-buy, quote:add and print-env; empty uses the newest deployments/*.json.
DEPLOYMENT=

# ── Verification on `target` (optional) ──────────────────────────────────────
# Etherscan API key; enough on its own for any chain Etherscan already lists.
ETHERSCAN_API_KEY=
# Explorer kind for a chain Etherscan does not list: etherscan (compatible API) or blockscout.
TARGET_EXPLORER=
# Browser URL of that explorer.
TARGET_EXPLORER_URL=
# API URL of that explorer.
TARGET_EXPLORER_API_URL=

# ── Adding an ERC-20 quote asset (quote:add, see scripts/addQuoteAsset.ts) ──
# Token to approve as a quote asset.
QUOTE_TOKEN=
# Whole quote tokens one native unit is worth; derives both figures below from launch config #0.
QUOTE_PER_NATIVE=
# Or set directly: the curve's virtual starting reserve, in whole tokens.
QUOTE_PHANTOM=
# Or set directly: real quote raised at graduation, in whole tokens.
QUOTE_GRADUATION_THRESHOLD=
# Decimals the figures are sized against; empty reads decimals() from the token.
QUOTE_DECIMALS=

# ── Checking against the live Pons deployment on Robinhood Chain ─────────────
# Robinhood Chain mainnet archive RPC for ponsFork and parity; the public RPC keeps ~9 minutes of state.
FORK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Block to pin ponsFork to; empty forks at head.
FORK_BLOCK_NUMBER=
# Robinhood Chain mainnet RPC for ponsMainnet.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Robinhood Chain testnet RPC for ponsTestnet and ponsTestnetFork.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
